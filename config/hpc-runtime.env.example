# Copy to private/runtime.env ON THE HPC only. This file contains no credentials.
# curator_root is supplied by config/hpc-python.sh.
HPC_APPTAINER=/opt/shared/apptainer/1.4.1/bin/apptainer
HPC_CONTROL_IMAGE="$curator_root/containers/python312.sif"
HPC_CONTROL_PYTHON="$curator_root/.venv-control/bin/python"
# Fill these only after validating the host driver, container and model stack.
HPC_GPU_IMAGE=
HPC_GPU_PYTHON=
